  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Verifica que el código HTTP de la respuesta coincida con el indicado en el nombre del request, ej: \"Crear reserva (201)\"",
          "const esperado = pm.info.requestName.match(/\\((\\d{3})\\)/);",
          "if (esperado) {",
          "    pm.test(\"Responde \" + esperado[1], () => pm.response.to.have.status(Number(esperado[1])));",
          "}"
